#include "stm32f407g (2).h"
#include <stdint.h>


/* Registros utilizados del ADC1 */
#define ADC1_SR_REG      ((volatile uint32_t *)0x40012000U)
#define ADC1_CR2_REG     ((volatile uint32_t *)0x40012008U)
#define ADC1_SQR3_REG    ((volatile uint32_t *)0x40012034U)
#define ADC1_DR_REG      ((volatile uint32_t *)0x4001204CU)


/* ================================================================
 * GPIO
 * ================================================================ */

void GPIO_HabilitarReloj(char puerto)
{
    RCC_AHB1ENR_t *pRCC =
        (RCC_AHB1ENR_t *)ADDR_RCC_AHB1_BASE;

    switch (puerto)
    {
        case 'A':
            pRCC->GPIOAEN = 1;
            break;

        case 'B':
            pRCC->GPIOBEN = 1;
            break;

        case 'C':
            pRCC->GPIOCEN = 1;
            break;

        default:
            break;
    }
}


void GPIO_ConfigurarSalida(char puerto, int pin)
{
    uint32_t direccion;

    switch (puerto)
    {
        case 'A':
            direccion = ADDR_GPIOA_BASE;
            break;

        case 'B':
            direccion = ADDR_GPIOB_BASE;
            break;

        case 'C':
            direccion = ADDR_GPIOC_BASE;
            break;

        default:
            return;
    }

    volatile uint32_t *pMODER =
        (volatile uint32_t *)(direccion + GPIO_OFFSET_MODER);

    *pMODER &= ~(0x3U << (pin * 2));
    *pMODER |=  (0x1U << (pin * 2));
}


void GPIO_Escribir(char puerto, int pin, int valor)
{
    uint32_t direccion;

    switch (puerto)
    {
        case 'A':
            direccion = ADDR_GPIOA_BASE;
            break;

        case 'B':
            direccion = ADDR_GPIOB_BASE;
            break;

        case 'C':
            direccion = ADDR_GPIOC_BASE;
            break;

        default:
            return;
    }

    volatile uint32_t *pODR =
        (volatile uint32_t *)(direccion + GPIO_OFFSET_ODR);

    if (valor)
        *pODR |= (1U << pin);
    else
        *pODR &= ~(1U << pin);
}


